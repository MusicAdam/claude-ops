#!/usr/bin/env bash
# opsctl start|stop|restart|pause|resume|status|log|open  — manage the claude-ops background service (launchd)
# stop and restart pause every running task first; the next daemon resumes them (tasks you paused stay paused)
# pause stops every running task now (each resumes from where it was); resume puts them back in the queue
set -euo pipefail
OPS="$(cd "$(dirname "$0")" && pwd)"
LABEL=com.claude-ops
DATA="${OPS_DATA:-$HOME/.claude-ops}"; mkdir -p "$DATA"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SVC="gui/$(id -u)/$LABEL"
APP="$DATA/Claude Ops.app"   # launchd starts the daemon through this, so macOS privacy prompts name "Claude Ops"
BIN="$APP/Contents/MacOS/claude-ops"
build_app() {  # only when missing or launcher.c changed: a rebuild changes the signature and macOS asks again
  [ -x "$BIN" ] && [ "$BIN" -nt "$OPS/launcher.c" ] && return
  mkdir -p "$APP/Contents/MacOS"
  cat > "$APP/Contents/Info.plist" <<IP
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>$LABEL</string>
  <key>CFBundleName</key><string>Claude Ops</string>
  <key>CFBundleExecutable</key><string>claude-ops</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSBackgroundOnly</key><true/>
</dict></plist>
IP
  clang -O2 -o "$BIN" "$OPS/launcher.c"
  codesign -s - -f --identifier "$LABEL" "$APP"
  echo "built $APP"
}
write_plist() {
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$BIN</string><string>/opt/homebrew/bin/python3</string><string>$OPS/opsd.py</string><string>serve</string></array>
  <key>AssociatedBundleIdentifiers</key><string>$LABEL</string>
  <key>WorkingDirectory</key><string>$OPS</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>$HOME</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ExitTimeOut</key><integer>60</integer>
  <!-- not Background: macOS throttles that to efficiency cores and slow I/O, and every gate and worker inherits it -->
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>$DATA/opsd.log</string>
  <key>StandardErrorPath</key><string>$DATA/opsd.log</string>
</dict></plist>
PL
}
URL=http://127.0.0.1:8788
fail() {  # say why start failed; a restart the queue ran (restart_self) also logs it on its task
  echo "$1" >&2
  if [ -n "${OPS_RESTART_TASK:-}" ]; then
    OPS_DATA="$DATA" /opt/homebrew/bin/python3 "$OPS/opsd.py" event "$OPS_RESTART_TASK" \
      "claude-ops restart failed: $1 See $DATA/runs/$OPS_RESTART_TASK/restart.log and opsctl log." || true
  fi
  exit 1
}
wait_up() {  # the daemon binds its port before it loads projects, so it should answer within seconds
  for _ in $(seq 30); do
    curl -sf -m 2 -o /dev/null "$URL/api/state" && { echo "dashboard: $URL"; return 0; }
    sleep 1
  done
  echo "Last lines of $DATA/opsd.log:" >&2; tail -n 20 "$DATA/opsd.log" >&2 || true
  fail "The claude-ops daemon did not answer on $URL within 30 s."
}
case "${1:-status}" in  # start, stop and restart act on the one launchd service, whatever OPS_DATA says
  start|stop|restart)
    if [ "$DATA" != "$HOME/.claude-ops" ]; then
      echo "opsctl: OPS_DATA is $DATA, but opsctl $1 acts on the launchd service (~/.claude-ops)." >&2
      echo "Stop a scratch daemon by its pid: kill \"\$(cat \"\$OPS_DATA/opsd.pid\")\"" >&2; exit 1
    fi
    if [ -f "$OPS/.git" ]; then
      echo "opsctl: $OPS is a git worktree. opsctl $1 would point the launchd service at it; run opsctl from your checkout." >&2
      exit 1
    fi ;;
esac
case "${1:-status}" in
  start)   build_app; write_plist
           if launchctl print "$SVC" >/dev/null 2>&1; then launchctl kickstart "$SVC"
           else  # bootstrap fails while a stopped job is still unloading; retry rather than leave it down
             for i in $(seq 10); do launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null && break
               [ "$i" = 10 ] && fail "launchctl bootstrap failed; run: $0 start"; sleep 1; done
           fi
           wait_up ;;
  stop)    launchctl bootout "$SVC" 2>/dev/null || true
           # it pauses its tasks before it exits (opsd.py shutdown); launchd lists the job until it has
           for _ in $(seq 70); do launchctl print "$SVC" >/dev/null 2>&1 || break; sleep 1; done
           echo stopped ;;
  restart) "$0" stop; "$0" start ;;
  pause|resume) OPS_DATA="$DATA" /opt/homebrew/bin/python3 "$OPS/opsd.py" "$1-all" ;;
  status)  launchctl print "$SVC" 2>/dev/null | grep -E '^\s*(state|pid|last exit code)' || echo "not running" ;;
  log)     tail -n 100 -f "$DATA/opsd.log" ;;
  open)    open "$URL" ;;
  *)       sed -n 2p "$0"; exit 2 ;;
esac
