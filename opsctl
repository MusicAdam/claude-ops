#!/usr/bin/env bash
# opsctl start|stop|restart [--now]|status|log|open  — manage the claude-ops background service (launchd)
# restart waits until no task is running a command (a gate, a build, a worker's test run); --now doesn't
set -euo pipefail
OPS="$(cd "$(dirname "$0")" && pwd)"
LABEL=com.claude-ops
DATA="${OPS_DATA:-$HOME/.claude-ops}"; mkdir -p "$DATA"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
write_plist() {
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string><string>$OPS/opsd.py</string><string>serve</string></array>
  <key>WorkingDirectory</key><string>$OPS</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>$HOME</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$DATA/opsd.log</string>
  <key>StandardErrorPath</key><string>$DATA/opsd.log</string>
</dict></plist>
PL
}
case "${1:-status}" in
  start)   write_plist; launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl kickstart "gui/$(id -u)/$LABEL"
           sleep 1; echo "dashboard: http://127.0.0.1:8788" ;;
  stop)    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true; echo stopped ;;
  restart) if [ "${2:-}" != "--now" ]; then OPS_DATA="$DATA" /opt/homebrew/bin/python3 "$OPS/opsd.py" wait-idle || exit 1; fi
           "$0" stop; sleep 1; "$0" start ;;
  status)  launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | grep -E '^\s*(state|pid|last exit code)' || echo "not running" ;;
  log)     tail -n 100 -f "$DATA/opsd.log" ;;
  open)    open http://127.0.0.1:8788 ;;
  *)       sed -n 2p "$0"; exit 2 ;;
esac
